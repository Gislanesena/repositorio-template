# =============================================================================
# .gitignore — 1º Hackathon FATEC Itaquera
# Cobre as stacks mais comuns usadas no evento
# =============================================================================


# ── Variáveis de ambiente (NUNCA commitar!) ───────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.*.local


# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
dist/
build/
.next/
.nuxt/
out/
.cache/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
*.log


# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
venv/
.venv/
env/
.env/
*.pyc


# ── PHP ───────────────────────────────────────────────────────────────────────
/vendor/


# ── Java / Kotlin ─────────────────────────────────────────────────────────────
*.class
*.jar
*.war
target/
.gradle/
build/


# ── Banco de dados local ──────────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db


# ── IDEs e editores ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.user


# ── Sistema operacional ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini


# ── Uploads e arquivos temporários ───────────────────────────────────────────
uploads/
tmp/
temp/


# ── Cobertura de testes ───────────────────────────────────────────────────────
coverage/
.nyc_output/
